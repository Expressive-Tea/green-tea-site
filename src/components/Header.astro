---
import logoUrl from '../assets/logo.svg?url';

const navLinks = [
  { label: 'Docs', href: 'https://green-tea.expressive-tea.io/docs', external: true },
  { label: 'Blog', href: '/blog', external: false },
  { label: 'GitHub', href: 'https://github.com/Expressive-Tea/green-tea', external: true },
  { label: 'npm', href: 'https://www.npmjs.com/package/@green-tea/core', external: true },
];
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="wordmark" href="/" aria-label="Green Tea. — home">
      <img class="wordmark__logo" src={logoUrl} alt="" width="24" height="24" />
      <span class="wordmark__text">Green Tea<span class="wordmark__dot">.</span></span>
    </a>

    <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-hidden="true" />
    <label for="nav-toggle" class="nav-toggle__label" aria-label="Toggle navigation menu">
      <span></span>
      <span></span>
      <span></span>
    </label>

    <nav class="site-nav" aria-label="Primary">
      <ul>
        {
          navLinks.map((link) => (
            <li>
              <a href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noopener noreferrer' : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: color-mix(in srgb, var(--base) 88%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid color-mix(in srgb, var(--panel) 80%, var(--base));
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 1rem;
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--ink);
  }

  .wordmark:hover,
  .wordmark:focus-visible {
    text-decoration: none;
    color: var(--ink);
  }

  .wordmark__logo {
    width: 1.6rem;
    height: 1.6rem;
    flex-shrink: 0;
  }

  .wordmark__text {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.15rem;
    color: var(--matcha);
    letter-spacing: 0.01em;
  }

  .wordmark__dot {
    color: var(--violet);
  }

  .site-nav ul {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-nav a {
    color: var(--dim);
    font-size: 0.95rem;
    font-weight: 500;
  }

  .site-nav a:hover,
  .site-nav a:focus-visible {
    color: var(--matcha);
    text-decoration: none;
  }

  .nav-toggle {
    display: none;
  }

  .nav-toggle__label {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 2rem;
    height: 2rem;
    cursor: pointer;
  }

  .nav-toggle__label span {
    display: block;
    height: 2px;
    background: var(--ink);
    border-radius: 2px;
  }

  @media (max-width: 640px) {
    .nav-toggle__label {
      display: flex;
    }

    .site-nav {
      display: none;
      width: 100%;
      order: 3;
    }

    .site-nav ul {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
      padding-block: 1rem;
    }

    .nav-toggle:checked ~ .site-nav {
      display: block;
    }

    .site-header__inner {
      flex-wrap: wrap;
    }
  }
</style>
