---
import Base from '../layouts/Base.astro';
import GraphMotif from '../components/GraphMotif.astro';

const title = '404 — Green Tea.';
const description = 'This page steeped too long. It’s gone — but the rest of the garden is right here.';
---

<Base title={title} description={description} robots="noindex, follow">
  <section class="notfound section">
    <div class="wrap notfound__inner">
      <div class="notfound__text">
        <p class="kicker">404</p>
        <h1>This page steeped too long.</h1>
        <p class="notfound__body">
          Whatever you were looking for isn’t here anymore — or never was. Let’s get you back to solid ground.
        </p>
        <div class="btn-row">
          <a class="btn btn--primary" href="/">Back home</a>
          <a class="btn btn--ghost" href="/blog">Read the blog</a>
        </div>
      </div>

      <GraphMotif class="notfound__motif" width={320} height={280} opacity={0.4} />
    </div>
  </section>
</Base>

<style>
  .notfound {
    min-height: 60vh;
    display: flex;
    align-items: center;
  }

  .notfound__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 320px);
    align-items: center;
    gap: clamp(2rem, 6vw, 4rem);
  }

  .notfound__text {
    max-width: 46ch;
  }

  .notfound__body {
    color: var(--dim);
    font-size: 1.1rem;
    line-height: 1.7;
    margin-bottom: 2rem;
  }

  :global(.notfound__motif) {
    justify-self: center;
    width: 100%;
    max-width: 280px;
    height: auto;
  }

  @media (max-width: 760px) {
    .notfound__inner {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .notfound__text {
      max-width: none;
      margin: 0 auto;
    }

    .btn-row {
      justify-content: center;
    }

    :global(.notfound__motif) {
      max-width: 200px;
      opacity: 0.3;
    }
  }
</style>
