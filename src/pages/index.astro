---
import Base from '../layouts/Base.astro';
import Hero from '../components/sections/Hero.astro';
import WhoDoesTheWork from '../components/sections/WhoDoesTheWork.astro';
import GraphNotChain from '../components/sections/GraphNotChain.astro';
import FollowsDemand from '../components/sections/FollowsDemand.astro';
import HowItCompares from '../components/sections/HowItCompares.astro';
import RunsEverywhere from '../components/sections/RunsEverywhere.astro';
import RealTime from '../components/sections/RealTime.astro';
import Batteries from '../components/sections/Batteries.astro';
import SeeIt from '../components/sections/SeeIt.astro';
import Faq from '../components/sections/Faq.astro';
import HonestBeta from '../components/sections/HonestBeta.astro';

const title = 'Green Tea — Dependency-driven TypeScript backend framework';
const description =
  'Build TypeScript backends with less infrastructure in your head. Declare what your code needs and Green Tea derives, validates and executes the graph across Node, Deno, Bun and the edge.';
const canonicalURL = new URL('/', Astro.site).toString();
const repositoryURL = 'https://github.com/Expressive-Tea/green-tea';
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${canonicalURL}#website`,
      url: canonicalURL,
      name: 'Green Tea',
      description,
    },
    {
      '@type': 'SoftwareApplication',
      '@id': `${canonicalURL}#software`,
      name: 'Green Tea',
      description,
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'Cross-platform',
      url: canonicalURL,
      sameAs: repositoryURL,
      license: `${repositoryURL}/blob/main/LICENSE`,
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD',
      },
    },
  ],
};
---

<Base title={title} description={description} structuredData={structuredData}>
  <Hero />
  <WhoDoesTheWork />
  <GraphNotChain />
  <FollowsDemand />
  <SeeIt />
  <RealTime />
  <Batteries />
  <RunsEverywhere />
  <HowItCompares />
  <Faq />
  <HonestBeta />
</Base>
